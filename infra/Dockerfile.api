FROM python:3.11-slim

WORKDIR /app
# Copy package
COPY python/ /app/python/
# Install package (editable not required in container; regular install is fine)
RUN pip install --no-cache-dir /app/python

# Runtime env: .env will be mounted from infra/.env (do not copy secrets into image)
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/python

EXPOSE 8000
CMD ["uvicorn", "alphamatrix.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
